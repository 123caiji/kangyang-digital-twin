# 环境变量模板：复制为 server/.env 后填入真实值
#   cp server/.env.example server/.env
# server/.env 已被 .gitignore 忽略，**不要**把真实密钥提交到仓库

# 后端监听端口（默认 3001）
PORT=3001
NODE_ENV=development

# JWT 签发密钥：务必使用随机值
# 生成方式（任选其一）
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
#   openssl rand -base64 48
JWT_SECRET=

# 大模型接入（OpenAI 兼容接口）
# LLM_API_URL 示例：https://api.siliconflow.cn  或自建网关 http://<host>:<port>
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# 单次回答的最大 token 数。推理型模型会先消耗 reasoning_tokens，
# 取值过小会导致 finish_reason=length 且正文为空，建议不低于 1024
LLM_MAX_TOKENS=2048
